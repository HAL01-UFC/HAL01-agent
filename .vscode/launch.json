{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Uvicorn (uv run)",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload",
                "--port",
                "3000"
            ],
            "jinja": true,
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "pythonPath": "${workspaceFolder}/.venv/bin/python"
        }
    ]
}

